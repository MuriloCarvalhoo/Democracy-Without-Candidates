# Copy to your process manager/environment. Values here are examples, not real resources.
DWC_ENV=development
DWC_DB_PATH=data/dev.db
DWC_COUNTRY=BR
DWC_IDENTITY_PROVIDER=synthetic
# Development/test only, rejected in production: skip TOTP code checks.
# DWC_DEV_SKIP_TOTP=1
# Development/test only, rejected in production: log entry/exit and safe inputs of
# instrumented functions (never passwords, codes, tokens, face data or ballot choices).
# DWC_DEBUG=1
# Log filter (tracing EnvFilter). Unset: development/test "dwc=info,tower_http=info,warn",
# with DWC_DEBUG "dwc=debug,tower_http=debug,info", production "dwc=info,tower_http=warn,warn".
# RUST_LOG=dwc=debug
# Production also requires:
# DWC_PUBLIC_ORIGIN=https://<subdomínio-do-país>
# DWC_SECRET_KEY_FILE=/etc/dwc/secret.key
# DWC_AUDIT_SIGNING_KEY_FILE=/etc/dwc/audit-signing.key  (hex ed25519 seed, chmod 600;
#   dev/test default: audit-signing.key next to DWC_DB_PATH, generated on first use)
# DWC_IDENTITY_PROVIDER=face-service
# DWC_FACE_SERVICE_URL=http://127.0.0.1:8001
# DWC_FACE_SERVICE_KEY_FILE=/etc/dwc/face.key  # same file as the face service's DWC_FACE_KEY_FILE
# Optional online snapshots on SIGUSR1 (see ops/README.md):
# DWC_SNAPSHOT_DIR=/var/lib/dwc/snapshots
LEPTOS_SITE_ADDR=127.0.0.1:3000
LEPTOS_SITE_ROOT=target/site
