# /etc/dwc/dwc.env (mode 0600, owner root:dwc). Placeholders only; never commit real values.
DWC_ENV=production
DWC_COUNTRY=BR
DWC_DB_PATH=/var/lib/dwc/instance.db
DWC_PUBLIC_ORIGIN=https://<subdominio>
DWC_SECRET_KEY_FILE=/etc/dwc/secret.key
DWC_IDENTITY_PROVIDER=face-service
DWC_FACE_SERVICE_URL=http://127.0.0.1:8001
# Online snapshots on SIGUSR1 (existing absolute directory, owned by dwc).
DWC_SNAPSHOT_DIR=/var/lib/dwc/snapshots
LEPTOS_SITE_ADDR=127.0.0.1:3000
LEPTOS_SITE_ROOT=/opt/dwc/current/site
LEPTOS_OUTPUT_NAME=dwc
RUST_LOG=info
